# ============================================
# AgriMind AI — Root Environment Configuration Template
# ============================================
# Copy this file to .env or configure respective subproject environments

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Backend Application
APP_NAME="AgriMind AI API"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL with pgvector)
# Format: postgresql://username:password@localhost:5432/agrimind_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrimind_db

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Artificial Intelligence & External APIs (Placeholders - Populate when ready)
GEMINI_API_KEY=
WEATHER_API_KEY=
MANDI_API_KEY=
DISEASE_API_URL=http://localhost:5000/api/v1/diagnose
DISEASE_API_KEY=
