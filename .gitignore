# ============================================
# AgriMind AI — Root Git Ignore
# ============================================

# Environment and Local Secrets
.env
.env.local
.env.*.local
*.env

# Operating System
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Node.js & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.vite/

# Python & Backend
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*/venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Large Model Weights and Datasets
ml/datasets/*.csv
ml/datasets/*.parquet
ml/models/*.pt
ml/models/*.onnx
ml/models/*.bin
ml/models/*.joblib
!ml/datasets/.gitkeep
!ml/models/.gitkeep
